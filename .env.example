# Supabase Postgres connection string used by Drizzle
# Supabase dashboard > Project Settings > Database > Connection string.
DATABASE_URL=

# Supabase Auth credentials used by the signup flow.
# Supabase dashboard > Project Settings > API. Use the publishable key, not
# the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
